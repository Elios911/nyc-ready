# NYC Ready environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Leave BOTH Supabase values empty to run in DEMO MODE: no account needed,
# data is kept in server memory for your browser session, and every price is
# clearly labelled as demonstration data.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_…). The legacy "anon" key also works
# via NEXT_PUBLIC_SUPABASE_ANON_KEY. This key is safe to expose to the browser;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app, used in sign-up confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
